# Copy to .env (or .env.development.local) and fill in. Never commit real values.
# In production, set these in your hosting dashboard instead.

# --- Server ---
NODE_ENV=development
# Most hosts (Railway, Render) inject PORT automatically.
PORT=5000

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Auth (JWT_SECRET is required when NODE_ENV=production) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Frontend origin: used for CORS and links in emails. No trailing slash. ---
# Production example: https://oneplace-c1b.pages.dev
CLIENT_URL=http://localhost:5173

# --- Email / SMTP (required in production: sign-in needs a verified email) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@oneplace.app

# --- File uploads: S3 or Cloudflare R2 (for R2: S3_REGION=auto) ---
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CDN_URL=

# --- AI ---
GROQ_API_KEY=
# Optional: removes HuggingFace embedding rate limits
HF_API_KEY=

# --- Live events (Daily.co video rooms) ---
DAILY_API_KEY=
